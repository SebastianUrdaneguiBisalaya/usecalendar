{
  "name": "@usecalendar/react",
  "version": "0.1.0",
  "description": "React components and hooks for usecalendar: a Google Calendar-style month, week and day calendar, styled with Tailwind CSS and fully driven by props.",
  "keywords": [
    "calendar",
    "react",
    "react-calendar",
    "scheduler",
    "month-view",
    "week-view",
    "day-view",
    "event-calendar",
    "google-calendar",
    "tailwindcss",
    "usecalendar"
  ],
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/usecalendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/usecalendar.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/SebastianUrdaneguiBisalaya/usecalendar/issues"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && pnpm run build:css",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify && node -e \"require('node:fs').copyFileSync('src/styles/theme.css','dist/theme.css')\"",
    "dev": "tsup --watch",
    "dev:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@usecalendar/core": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
