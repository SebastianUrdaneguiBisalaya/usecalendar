{
  "name": "@usecalendar/core",
  "version": "0.1.0",
  "description": "Framework-agnostic core of usecalendar: calendar types, visible ranges, month/week/day layout and drag/keyboard math for Google Calendar-style calendar UIs.",
  "keywords": [
    "calendar",
    "scheduler",
    "month-view",
    "week-view",
    "day-view",
    "event-calendar",
    "google-calendar",
    "temporal",
    "typescript",
    "usecalendar"
  ],
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/usecalendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/usecalendar.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/SebastianUrdaneguiBisalaya/usecalendar/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "devDependencies": {
    "temporal-polyfill": "1.0.8",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
