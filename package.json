{
  "name": "usecalendar",
  "version": "0.0.0",
  "description": "Monorepo for usecalendar: a Google Calendar-style calendar UI library (framework-agnostic core + React adapter).",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/usecalendar.git"
  },
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "bench": "pnpm -r run bench",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "storybook": "pnpm --filter @usecalendar/storybook run storybook"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "3.0.3",
    "husky": "9.1.7"
  }
}
