{
  "name": "usecalendar",
  "version": "0.0.0",
  "description": "Monorepo for usecalendar: a Google Calendar-style calendar UI library (framework-agnostic core + React adapter).",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/usecalendar.git"
  },
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "scripts": {
    "build": "pnpm --filter ./packages/* run build",
    "dev": "pnpm --filter ./packages/core run dev",
    "typecheck": "pnpm --filter ./packages/* run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --filter ./packages/* run test",
    "test:watch": "pnpm --filter ./packages/core run test:watch",
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "husky": "9.1.7"
  }
}
